<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- World-map flight marker: taxi sprite instead of default yellow caravan circle -->
  <WorldObjectDef ParentName="ShuttleWorldObjectBase">
    <defName>TravelingRimTaxi</defName>
    <label>taxi shuttle</label>
    <description>A civilian taxi shuttle in flight.</description>
    <!-- Compact world-map disc / non-expanded drawer -->
    <texture>World/WorldObjects/RimTaxi</texture>
    <!-- Expanded / zoomed world map icon -->
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/WorldObjects/Expanding/RimTaxi</expandingIconTexture>
    <!-- White so the taxi art is not recolored -->
    <expandingIconColor>(255,255,255)</expandingIconColor>
    <expandingIconDrawSize>1.5</expandingIconDrawSize>
    <expandingIconPriority>65</expandingIconPriority>
  </WorldObjectDef>

</Defs>
