<?xml version="1.0" encoding="utf-8"?>
<!--
  Taxi skyfallers: match larger drawSize + small silhouette shadow.
-->
<Defs>

  <ThingDef ParentName="ShuttleSkyfallerBase">
    <defName>RimTaxiIncoming</defName>
    <label>taxi shuttle (incoming)</label>
    <!-- Custom class: shadow follows angled approach under the craft -->
    <thingClass>RimTaxi.RimTaxiIncoming</thingClass>
    <size>(5,3)</size>
    <graphicData>
      <texPath>Things/Building/Misc/RimTaxiShuttle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>(7.2, 5.8)</drawSize>
      <color>(255,255,255)</color>
    </graphicData>
    <skyfaller>
      <movementType>Decelerate</movementType>
      <shadow>Things/Skyfaller/RimTaxiShadow</shadow>
      <!-- Keep landing blob modest vs old rectangle (5.5,3.5) -->
      <shadowSize>(3.2, 2.8)</shadowSize>
      <motesPerCell>1</motesPerCell>
      <anticipationSound>Shuttle_Landing</anticipationSound>
      <anticipationSoundTicks>250</anticipationSoundTicks>
      <ticksToImpactRange>200~250</ticksToImpactRange>
      <angleCurve>
        <points>
          <li>(0,-60)</li>
          <li>(1,-90)</li>
        </points>
      </angleCurve>
      <rotationCurve>
        <points>
          <li>(0,30)</li>
          <li>(0.5,5)</li>
          <li>(0.9,-5)</li>
          <li>(0.95,0)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0.95,2.5)</li>
          <li>(1,0)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0.6,0.6)</li>
          <li>(0.95,0.1)</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>

  <ThingDef ParentName="ShuttleSkyfallerBase">
    <defName>RimTaxiLeaving</defName>
    <label>taxi shuttle (leaving)</label>
    <thingClass>RimTaxi.RimTaxiLeaving</thingClass>
    <size>(5,3)</size>
    <graphicData>
      <texPath>Things/Building/Misc/RimTaxiShuttle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>(7.2, 5.8)</drawSize>
      <color>(255,255,255)</color>
    </graphicData>
    <skyfaller>
      <reversed>true</reversed>
      <anticipationSound>Shuttle_Leaving</anticipationSound>
      <anticipationSoundTicks>-10</anticipationSoundTicks>
      <ticksToImpactRange>-40~-15</ticksToImpactRange>
      <moteSpawnTime>0.05</moteSpawnTime>
      <shadow>Things/Skyfaller/RimTaxiShadow</shadow>
      <shadowSize>(3.2, 2.8)</shadowSize>
      <motesPerCell>1</motesPerCell>
      <angleCurve>
        <points>
          <li>(0,90)</li>
          <li>(1,70)</li>
        </points>
      </angleCurve>
      <rotationCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.15,10)</li>
          <li>(0.5,-5)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.08,2)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0,0.2)</li>
          <li>(0.4,0.7)</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>

</Defs>
